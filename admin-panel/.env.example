# Senha única de acesso ao painel (login simples, sem cadastro de usuários --
# é pra uma equipe pequena). Troque por algo forte.
ADMIN_PASSWORD=troque_esta_senha

# Mesmo Postgres que o n8n e o server.js já usam.
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco
# Deixe "false" só se o Postgres não usar SSL (ex: instância local sem TLS).
DATABASE_SSL=true

PORT=3100

# Deixe em "true" (padrão) quando o painel estiver atrás de HTTPS -- exige
# que o navegador só mande o cookie de sessão por conexão segura. Só mude
# pra "false" se estiver testando em http:// puro (ex: localhost).
PANEL_COOKIE_SECURE=true

# Nome exibido no título da aba e no alt da logo (a logo/cores em si
# continuam idênticas em toda instância -- só esse texto muda). Deixe em
# branco em produção (usa "Dra. Aline Bentivegna" por padrão).
NOME_CLINICA=

# "false" esconde o botão "Sincronizar espelho" da Agenda -- use isso em
# deploys apontados pro standalone-bridge/ (não existe rota
# /sincronizar-agenda lá, public.consultas já é a fonte de verdade, não um
# espelho pra sincronizar). Deixe em branco em produção.
MOSTRAR_SINCRONIZAR_ESPELHO=

# Serviço de automação usado pela página Agenda -- pode ser o server.js
# da raiz (Simples Dental, produção) ou o standalone-bridge/ (Postgres
# puro, clínicas sem sistema próprio) -- mesmo contrato de rotas nos dois.
# BRIDGE_API_KEY precisa ser IDÊNTICA à configurada nesse serviço
# (variável BRIDGE_API_KEY lá também).
BRIDGE_URL=https://whatsapp-teste-github.usixhn.easypanel.host
BRIDGE_API_KEY=mesma_chave_configurada_no_servico_de_automacao

# Evolution API -- envio direto de mensagem pela página Mensagens. Mesmas
# credenciais já usadas pelo n8n (ver n8n/.env). Só a instância da Aline é
# produção -- pacientes reais só falam por ela.
EVOLUTION_BASE_URL=https://evolutionapi.tbentivegna.com.br
EVOLUTION_API_KEY=mesma_chave_configurada_no_n8n
EVOLUTION_INSTANCE_ALINE=AlineConsultorio
