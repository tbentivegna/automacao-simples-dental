# Clinicorp API -- base + autenticação
CLINICORP_API_BASE_URL=https://api.clinicorp.com/rest/v1
CLINICORP_ACCESS_ID=seu_id_de_acesso_aqui
CLINICORP_API_TOKEN=seu_token_api_aqui
# subscriber_id/code_link são exigidos por endpoint (além do Basic Auth
# acima) -- relação exata entre os dois ainda não confirmada com uma
# chamada real, ver README.md.
CLINICORP_SUBSCRIBER_ID=
CLINICORP_CODE_LINK=

# Recursos da clínica no Clinicorp (buscar uma vez via GET /business/list,
# /professional/list_all_professionals, /business/list_chairs durante o
# onboarding, e fixar aqui -- mesmo padrão de SIMPLES_DENTAL_CLINICA/
# SIMPLES_DENTAL_PROFISSIONAL hoje)
CLINICORP_BUSINESS_ID=
CLINICORP_DENTIST_PERSON_ID=
CLINICORP_SCHEDULE_TO_ID=

# Mesmo significado que no server.js da raiz
DURACAO_CONSULTA_MINUTOS=60
SEMANAS_A_VERIFICAR=4
PORT=3000

# Chave própria desta clínica -- não reaproveitar a de outra
BRIDGE_API_KEY=

# Mesmo Postgres/schema que o n8n e o painel admin desta clínica usam
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco
DATABASE_SSL=true
