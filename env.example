SIMPLES_DENTAL_URL=https://app.simplesdental.com/simples/login
SIMPLES_DENTAL_USER=seu_usuario_aqui
SIMPLES_DENTAL_PASS=sua_senha_aqui
SIMPLES_DENTAL_CLINICA=ALINE BENTIVEGNA
SIMPLES_DENTAL_PROFISSIONAL=Aline Ramos Bentivegna
DURACAO_CONSULTA_MINUTOS=90
SEMANAS_A_VERIFICAR=4
SABADO_DATA_REFERENCIA=2026-08-01
PORT=3000

# Mesmo Postgres que o n8n usa -- só para registrar eventos de agenda
# (public.eventos_agenda), usados pelo Analytics Agent. Se não configurado,
# o registro fica desativado sem quebrar o resto do serviço.
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco
# Deixe "false" só se o Postgres não usar SSL (ex: instância local sem TLS).
DATABASE_SSL=true
