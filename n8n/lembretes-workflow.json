      "id": "lembretes-012",
      "name": "Pode enviar?"
    },
    {
      "parameters": {
        "jsCode": "const lembrete = $('Loop Lembretes').item.json;\nconst consentimento = $json;\n\nconst nome = (consentimento.nome || '').split(' ')[0] || '';\nconst saudacao = nome ? `Olá ${nome}!` : 'Olá!';\nconst quandoTexto = lembrete.quando === 'hoje' ? 'hoje' : 'amanhã';\n\nlet mensagem = `${saudacao} 🤎 Passando pra lembrar que ${quandoTexto} você tem consulta agendada às ${lembrete.hora} com a Dra. Aline.`;\n\nif (lembrete.status === 'Confirmada') {\n  mensagem += ' Te esperamos lá 🙂';\n} else {\n  mensagem += ' Pode confirmar sua presença respondendo por aqui, ou me avisar se precisar remarcar ou cancelar 😊';\n}\n\nreturn {\n  mensagem,\n  telefoneJid: `55${lembrete.telefone}@s.whatsapp.net`,\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        60
      ],
      "id": "lembretes-013",
      "name": "Monta Mensagem do Lembrete"
    },
    {
      "parameters": {
        "resource": "messages-api",
        "instanceName": "={{ $('Config Instance').first().json.Instance }}",
        "remoteJid": "={{ $json.telefoneJid }}",
        "messageText": "={{ $json.mensagem }}",
        "options_message": {
          "delay": 800,
          "linkPreview": false
        }
      },
      "type": "n8n-nodes-evolution-api.evolutionApi",
      "typeVersion": 1,
