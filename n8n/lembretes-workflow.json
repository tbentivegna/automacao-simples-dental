      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.eventos_agenda (tipo, telefone, data_consulta, hora_consulta)\nVALUES ('lembrete_enviado', '{{ $('Loop Lembretes').item.json.telefone }}', TO_DATE('{{ $('Loop Lembretes').item.json.data }}', 'DD/MM/YYYY'), '{{ $('Loop Lembretes').item.json.hora }}');",
        "options": {}
