# Mesmo significado que no server.js da raiz / clinicorp-bridge
DURACAO_CONSULTA_MINUTOS=60
SEMANAS_A_VERIFICAR=4
PORT=3000

# Chave própria desta clínica -- não reaproveitar a de outra
BRIDGE_API_KEY=

# Postgres PRÓPRIO desta clínica (isolamento por database, não schema --
# ver Checklist_Onboarding_Nova_Clinica.md). Precisa ter rodado as
# migrations: 007 (funil_agendamento), 008 (funil_etapa), 009
# (configuracao_horarios), 011 (consultas), 012 (paciente_dependente), e
# o schema base (eventos_agenda, n8n_chat_histories -- ver db/).
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco
DATABASE_SSL=true
